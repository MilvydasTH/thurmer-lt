{
  "expo": {
    "name": "Skanu",
    "slug": "skanu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skanu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.skanu.recipes",
      "infoPlist": {
        "NSCameraUsageDescription": "Skanu uses the camera to photograph recipes and dishes.",
        "NSPhotoLibraryUsageDescription": "Skanu reads photos you choose so you can attach them to recipes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.skanu.recipes",
      "adaptiveIcon": {
        "backgroundColor": "#D9480F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-localization",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Skanu reads photos you choose so you can attach them to recipes.",
          "cameraPermission": "Skanu uses the camera to photograph recipes and dishes."
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Skanu uses your approximate location to show grocery offers from stores near you."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
