# Server-side only (read by the API routes, never bundled into the app).
# Enables reading recipes from photos and messy captions, and recipe translation.
ANTHROPIC_API_KEY=

# Optional: model used for those AI features.
# SKANU_AI_MODEL=claude-opus-5-5

# Where the phone app finds the server routes once deployed (leave empty in development and on web).
# EXPO_PUBLIC_API_URL=https://your-deployment.example.com
